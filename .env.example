# Public URL of the deployed site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase project (Settings -> API). The anon key is safe to expose; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: send replies to contact messages from /admin (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="Abraham David <hello@your-domain.com>"
REPLY_TO_EMAIL=
